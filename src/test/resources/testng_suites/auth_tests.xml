<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite verbose="1" name="Auth Tests suite" skipfailedinvocationcounts="false" junit="false" parallel="methods"
       annotations="JDK" thread-count="2">

    <parameter name="jenkinsJobCreation" value="true"/>
    <parameter name="suiteOwner" value="nknysh"/>
    <parameter name="jenkinsJobName" value="Auth_tests"/>
    <parameter name="jenkinsJobType" value="web"/>
    <parameter name="jenkinsEmail" value="nadimarkava@solvd.com"/>
    <parameter name="jenkinsEnvironments" value="DEMO"/>

    <parameter name="jenkinsRegressionPipeline" value="My_WEB_Cron_Job"/>
    <parameter name="jenkinsPipelineScheduling" value="45 16 * * *"/>
    <parameter name="jenkinsRegressionMatrix" value="browser: chrome; browser:firefox"/>

    <test name="Authentication Tests">
        <classes>
            <class name="web.AuthenticationTest">
            <methods>
                <include name="verifySignUpTest" />
                <include name="verifySignUpInWithInvalidInputsTest" />
                <include name="verifyLogInTest" />
                <include name="verifyLogInWithInvalidInputsTest" />
            </methods>
            </class>
        </classes>
    </test>
</suite>